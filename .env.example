# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Shared secret for Eve agent ↔ Nuxt internal API (memory, Slack link).
# Must match on both the Nuxt app and the Eve service in production.
INTERNAL_API_SECRET=change-me-to-a-random-string-at-least-32-chars

# Memory — Eve's fileMemory() provider stores one private Blob document per user.
# On Vercel, attach a Blob store to the project and this is set automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional — canonical URL for SEO (Open Graph, canonical links)
# NUXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Database — required everywhere, including local development.
# NuxtHub is pinned to PostgreSQL, so there is no local file fallback.
# Provision via the Neon integration on the Vercel Marketplace
# (`vercel integration add neon`), then `vercel env pull`.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- MiniPrint trade agent ---------------------------------------------------
# Supabase: use the session pooler (port 5432) or direct connection, with sslmode=require.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Vercel AI Gateway (photo identification + message analysis). Not needed on Vercel (OIDC).
# AI_GATEWAY_API_KEY=

# Who may sign up (comma-separated). Unset: only the first account can be created.
# MP_ALLOWED_EMAILS=you@example.com

# Optional model overrides (AI Gateway ids).
# MP_ANALYSIS_MODEL=anthropic/claude-sonnet-5
# MP_VISION_MODEL=anthropic/claude-sonnet-5
